local function updateButton()
    if autoJump then
        jumpBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        js.Color = Color3.fromRGB(255, 0, 0)
    else
        jumpBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        js.Color = Color3.fromRGB(0, 255, 0)
    end
end

-- MINIMIZE / CLOSE
local minimized = false
local originalSize = UDim2.new(0, 200, 0, 120)

minimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        originalSize = mainFrame.Size
        mainFrame.Size = UDim2.new(0, 200, 0, 30)
        jumpBtn.Visible = false
        devLabel.Visible = false
        minimizeBtn.Text = "+"
    else
        mainFrame.Size = originalSize
        jumpBtn.Visible = true
        devLabel.Visible = true
        minimizeBtn.Text = "-"
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    autoJump = false
    keyActivated = false
    screenGui:Destroy()
end)

confirmBtn.MouseButton1Click:Connect(function()
    if keyBox.Text == "autojumpv1" then
        keyActivated = true
        keyFrame.Visible = false
        mainFrame.Visible = true
    else
        statusLabel.Text = "Sai key!"
    end
end)

jumpBtn.MouseButton1Click:Connect(function()
    if not keyActivated then return end
    autoJump = not autoJump
    updateButton()
end)

-- LOGIC NHẢY
RunService.Heartbeat:Connect(function()
    if not autoJump then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local now = tick()
    if now - lastJump < 0.35 then return end

    if hum.FloorMaterial ~= Enum.Material.Air then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        lastJump = now
    end
end)

player.CharacterAdded:Connect(function()
    lastJump = 0
end)
